# --- Data store (Upstash Redis — free tier is plenty) ---
# Create at https://console.upstash.com or via Vercel Marketplace ("Upstash for Redis").
# If you add it through Vercel Marketplace these are injected automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vapi webhook security ---
# Set the same value in Vapi Dashboard -> Phone Number -> Server URL -> Secret.
# Vapi will send it as the `x-vapi-secret` header; we reject calls without it.
VAPI_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Admin dashboard auth ---
# The business owner enters this token on /admin to edit hours/fees/slots.
ADMIN_TOKEN=change-me-to-another-long-random-string
